<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.axonops</groupId>
    <artifactId>cassandra-everywhere-strategy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>cassandra-everywhere-strategy-integration-tests</artifactId>
  <description>Mixed DSE/Apache Cassandra integration tests (Testcontainers). Run with -Pintegration.</description>

  <properties>
    <dse.image>datastax/dse-server:5.1.31</dse.image>
    <cassandra.image>cassandra:3.11.19</cassandra.image>
    <slf4j.version>1.7.36</slf4j.version>
  </properties>

  <dependencies>
    <!-- The jar under test. Declared so the reactor builds it first; the tests use the copy in target/plugin. -->
    <dependency>
      <groupId>com.axonops</groupId>
      <artifactId>cassandra-everywhere-strategy-cassandra-3.11</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Test-only module: do not build an empty jar. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-everywhere-jar</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.axonops</groupId>
                      <artifactId>cassandra-everywhere-strategy-cassandra-3.11</artifactId>
                      <version>${project.version}</version>
                      <type>jar</type>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}/plugin</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
              <systemPropertyVariables>
                <everywhere.jar>${project.build.directory}/plugin/cassandra-everywhere-strategy-cassandra-3.11-${project.version}.jar</everywhere.jar>
                <dse.image>${dse.image}</dse.image>
                <cassandra.image>${cassandra.image}</cassandra.image>
                <container.logs.dir>${project.build.directory}/container-logs</container.logs.dir>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
